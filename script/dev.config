#
# Development kernel configuration (common across all products)
#
# Location: kernel-6.1/arch/arm64/configs/dev.config
# Applied AFTER product config and BEFORE required.config.
# This file is OPTIONAL - only included when ENABLE_KERNEL_DEV_CONFIG := true.
#
# Use this file during bringup/debugging.
# Do NOT commit production build-breaking options here.
#
# Typical uses:
#   CONFIG_DYNAMIC_DEBUG=y
#   CONFIG_KGDB=y
#   CONFIG_KGDB_SERIAL_CONSOLE=y
#   CONFIG_DEBUG_FS=y
#   CONFIG_FTRACE=y
#   CONFIG_FUNCTION_TRACER=y
#

